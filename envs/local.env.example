# Copied to .env by `just setup <extra> local`. Machine-specific settings only; never commit .env.
PFN_REPRO_SETUP=local
PFN_REPRO_TORCH_EXTRA=cpu
# PFN_REPRO_RUNS_ROOT=/path/to/runs        default: <repo>/runs
# PFN_REPRO_DATA_ROOT=/path/to/data        default: <repo>/data
PFN_REPRO_REMOTE_HOST=<ssh-alias>
PFN_REPRO_REMOTE_DIR=PycharmProjects/pfn-repro
# PFN_REPRO_MLFLOW_URI=sqlite:////path/to/mlflow.db   default: <repo>/mlflow.db
